# ── Oracle Database ───────────────────────────────────────────────────────────
ORACLE_USER=your_user
ORACLE_PASSWORD=your_password
ORACLE_HOST=your_host
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=your_service

# Oracle connection pool sizing (default: 1–5)
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5

# Thick mode — required if you see DPY-3015 (old password verifier)
# Extract Instant Client Basic ZIP, then set:
ORACLE_THICK_MODE=0
ORACLE_CLIENT_LIB_DIR=

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
APP_PORT=8000
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                # true = structured JSON logs (auto-enabled in production)

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Production: set to your actual frontend domain — do NOT leave as localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://10.0.0.59:5173
